# Salin file ini menjadi .env untuk pengembangan lokal (JANGAN commit .env ke Git!)
ENVIRONMENT=development
PORT=8000

# Origin yang diizinkan mengakses API (pisahkan dengan koma, tanpa slash di akhir)
# Contoh production: https://username.github.io
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# Konfigurasi Firebase Admin SDK
FIREBASE_PROJECT_ID=dashboard-forecast-demand
FIREBASE_STORAGE_BUCKET=dashboard-forecast-demand.firebasestorage.app

# Pilih SALAH SATU cara autentikasi Firebase Admin:
# Opsi A (Lokal): path ke file JSON service account (file ini dikecualikan di .gitignore)
GOOGLE_APPLICATION_CREDENTIALS=
# Opsi B (Production / Render): isi mentah JSON service account (1 baris atau base64)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Wajib verifikasi Firebase ID Token di setiap endpoint terproteksi (WAJIB true di production!)
REQUIRE_AUTH=true

# Batas ukuran upload (MB) & jumlah job paralel
MAX_UPLOAD_MB=25
MAX_CONCURRENT_JOBS=2
