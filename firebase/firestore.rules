rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: pengguna harus terautentikasi dan hanya mengakses namespace UID miliknya sendiri.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Dokumen root workspace pengguna: profile, settings, activeDatasetId
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && (!('activeDatasetId' in request.resource.data)
            || request.resource.data.activeDatasetId is string);
      allow delete: if false;

      // Daftar dataset / history milik pengguna
      match /datasets/{datasetId} {
        allow read: if isOwner(uid);
        // Penulisan utama dilakukan backend (Admin SDK), namun pemilik boleh
        // memperbarui nama/status tampilan tertentu atau menghapus dataset miliknya.
        allow create: if isOwner(uid)
          && request.resource.data.uid == request.auth.uid;
        allow update: if isOwner(uid)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isOwner(uid);

        // Subcollection hasil forecasting per material (chunked agar aman dari batas 1 MiB)
        match /materials/{stockCode} {
          allow read: if isOwner(uid);
          allow write, delete: if isOwner(uid);
        }

        // Subcollection staging sementara — hanya boleh diakses oleh Backend Admin SDK
        match /staging/{chunkId} {
          allow read, write: if false;
        }
      }
    }

    // Blokir semua akses lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
